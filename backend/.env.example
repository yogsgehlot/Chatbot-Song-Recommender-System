# =============================================================================
# Conversational AI Music Recommender — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Application ---
APP_ENV=development         # development | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/music_recommender.db

# --- LLM Provider ---
# Options: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Local Ollama (must have Ollama running: https://ollama.ai)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Recommendation Engine ---
# Number of recommendations to return per query
DEFAULT_RECOMMENDATION_COUNT=5
MAX_RECOMMENDATION_COUNT=20

# Weights for hybrid scoring (must sum to 1.0)
CONTENT_WEIGHT=0.6
MOOD_WEIGHT=0.3
POPULARITY_WEIGHT=0.1

# --- Dataset ---
DATASET_PATH=./data/songs.csv

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# --- Logging ---
LOG_LEVEL=INFO
